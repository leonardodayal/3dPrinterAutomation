# Copy to .env and fill in. Never commit .env.

# --- Printer (Moonraker on the K1C after rooting + Creality Helper Script) ---
MOONRAKER_URL=http://192.168.1.50:7125
MOONRAKER_API_KEY=
# Web UI base used to resolve relative webcam paths (default: same host, port 4408)
MOONRAKER_WEB_URL=
# Served by printer/snapshot_server.py on the K1C (installed as /etc/init.d/S99printloop_snapshot)
CAMERA_SNAPSHOT_URL=http://192.168.1.228:8090/snapshot.jpg

# --- Claude: uses the local Claude Code CLI on your claude.ai subscription (no API key) ---
# Log in once with `claude auth login`. Any ANTHROPIC_API_KEY in the environment is ignored.
CLAUDE_BIN=claude
CLAUDE_MODEL=opus                  # alias for the latest Opus; or a full model name
CLAUDE_EFFORT=high
CLAUDE_TIMEOUT_SECONDS=1200

# --- Design + slicing ---
OPENSCAD_BIN=openscad
SLICER=orca                        # orca | prusaslicer
SLICER_BIN=/Applications/OrcaSlicer.app/Contents/MacOS/OrcaSlicer
SLICER_PROFILE=profiles/k1c_pla.ini  # PrusaSlicer: File > Export > Export Config with K1C presets selected
# For SLICER=orca: complete K1C presets built by scripts/build_orca_profiles.py
ORCA_MACHINE_JSON=profiles/k1c_machine.json
ORCA_PROCESS_JSON=profiles/k1c_process.json
ORCA_FILAMENT_JSON=profiles/k1c_filament_pla.json   # or k1c_filament_petg.json

# --- Slack ---
# SLACK_BACKEND: auto | mcp | bot | webhook | none
#   mcp     = your claude.ai Slack connector via Claude Code; posts AS YOU to SLACK_MCP_CHANNEL_ID
#   bot     = Slack app bot token (images + approvals)
#   webhook = text-only alerts
SLACK_BACKEND=auto
SLACK_MCP_CHANNEL_ID=
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# --- Shared request channel (python -m printloop serve) ---
REQUEST_CHANNEL_ID=                # channel id (C...) where coworkers post `print: ...`
APPROVER_USER_IDS=                 # comma-separated Slack user ids allowed to approve / answer printer questions
SERVE_POLL_SECONDS=120             # how often to check the channel (one Claude Code call each with mcp)

# --- Approvals: cli | slack ---
APPROVAL_BACKEND=cli
APPROVAL_POLL_SECONDS=10

# --- Monitoring ---
CHECK_INTERVAL_SECONDS=120
PAUSE_TIMEOUT_SECONDS=900          # paused with no answer -> cancel + heaters off
OBICO_ML_URL=http://127.0.0.1:3333 # local obico ml_api container (scripts/obico-ml.sh)
OBICO_ML_TOKEN=
OBICO_THRESHOLD=0.45               # tune on a test print (handoff build step 2)
OBICO_HIGH_THRESHOLD=0.8           # single frame above this triggers immediately
OBICO_CONSECUTIVE_HITS=2
K1C_DETECTOR=unavailable

# --- Facts about this printer that Claude should know when diagnosing failures ---
PRINTER_NOTES=Glue stick is applied to the bed on purpose; white streaks or haze on the bed in snapshots are glue, not debris. The camera sits low near the bed and the toolhead can block part of the view.

# --- Safety: set to 1 only after you have checked thermal runaway protection on the printer ---
THERMAL_PROTECTION_VERIFIED=0

RUNS_DIR=runs
